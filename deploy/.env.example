SSH_MCP_DOMAIN=ssh-mcp.example.com
# OAuth 默认使用浏览器授权。需要兼容静态令牌时，用 ssh-mcp generate-token 生成独立随机值。
SSH_MCP_TOKEN=
# 旧 token 管理模式使用另一枚随机令牌。
SSH_MCP_ADMIN_TOKEN=
# 仅在服务器配置引用该变量时填写。
LAB_SSH_PASSWORD=
# 可选命令审计。在容器中设置为 /data/commands.sqlite3 后启用。
SSH_MCP_COMMAND_AUDIT_DB=
SSH_MCP_AUDIT_COMMAND_TEXT=1
SSH_MCP_AUDIT_SHELL_INPUT=0
# 显式设置正文保存期限，例如 30 天。留空沿用当前保留策略。
SSH_MCP_AUDIT_RETENTION_DAYS=
