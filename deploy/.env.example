SSH_MCP_DOMAIN=ssh-mcp.example.com
# Generate with: ssh-mcp generate-token
SSH_MCP_TOKEN=replace-with-a-random-token-at-least-32-characters
# A DIFFERENT random token for the human operator console. Never give it to an AI client.
SSH_MCP_ADMIN_TOKEN=replace-with-a-different-random-admin-token
# Only needed if a configured server uses password_env=LAB_SSH_PASSWORD
LAB_SSH_PASSWORD=replace-with-the-server-password
