# 放入现有 Nginx 的 http 上下文（例如 sites-available），只启用一个副本。
# 替换域名、证书路径和端口；public_url 必须与下方公开 HTTPS 源完全一致。
map $http_origin $ssh_mcp_origin_allowed {
    default 0;
    "" 1;
    "https://ssh-mcp.example.com:8443" 1;
}

server {
    listen 8443 ssl;
    server_name ssh-mcp.example.com;
    ssl_certificate /etc/letsencrypt/live/ssh-mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ssh-mcp.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;
    if ($http_host != "ssh-mcp.example.com:8443") { return 403; }
    if ($ssh_mcp_origin_allowed = 0) { return 403; }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_next_upstream off;
    }
}
